# Set these as secret environment variables in Render. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-a-different-random-secret
TERMII_API_KEY=
TERMII_SENDER_ID=N-Alert
TERMII_CHANNEL=dnd
# Normalize to +234 followed by the 10-digit Nigerian subscriber number.
PORTAL_ADMIN_PHONE=+2348084861312
NODE_ENV=production
